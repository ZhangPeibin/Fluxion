{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxion.dev/schemas/fourmeme_token.v2.json",
  "title": "Fluxion fourmeme.token v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta", "chain", "as_of", "provenance", "coverage",
    "warnings", "unknowns", "data"
  ],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "chain": { "$ref": "#/$defs/chain" },
    "as_of": { "type": "string" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "unknowns": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["address", "name", "symbol", "phase"],
      "properties": {
        "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "name": { "type": "string" },
        "symbol": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "phase": { "type": "string", "enum": ["bonding", "graduated", "unknown"] },
        "template_id": { "type": "string" },
        "template_name": { "type": "string" },
        "agent_id_exclusive": { "type": "boolean" },
        "progress": { "type": "string" },
        "raised": { "type": "string" },
        "market_cap": { "type": "string" },
        "price": { "type": "string" },
        "total_supply": { "type": "string" },
        "sale_amount": { "type": "string" },
        "creator": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "created_at": { "type": "integer", "minimum": 0 },
        "launch_at": { "type": "integer", "minimum": 0 },
        "ai_creator": { "type": "boolean" },
        "version": { "type": "string" },
        "wallet_eligible": { "type": "boolean" },
        "eligibility_reason": { "type": "string" },
        "market": { "$ref": "#/$defs/market" },
        "tradability": { "$ref": "#/$defs/tradability" },
        "wallet_cap": { "$ref": "#/$defs/wallet_cap" }
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "capability", "request_id"],
      "properties": {
        "schema_version": { "const": 2 },
        "capability": { "const": "fourmeme.token" },
        "request_id": { "type": "string", "minLength": 1 }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id"],
      "properties": {
        "name": { "const": "bsc" },
        "id": { "const": 56 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "freshness"],
      "properties": {
        "sources": { "type": "array", "items": { "type": "object" } },
        "freshness": { "type": "string", "enum": ["fresh", "stale", "expired", "unknown"] },
        "age_secs": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions"],
      "properties": {
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["complete", "partial", "not_run", "unavailable", "not_configured"]
          }
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "source": { "type": "string" },
        "details": { "type": "object" }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "price": { "type": "string" },
        "max_price": { "type": "string" },
        "change_24h": { "type": "string" },
        "change_24h_percent": { "type": "number" },
        "volume_24h": { "type": "string" },
        "market_cap": { "type": "string" },
        "liquidity": { "type": "string" },
        "raised": { "type": "string" },
        "progress_percent": { "type": "number", "minimum": 0 }
      }
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "decimal"],
      "properties": {
        "raw": { "type": "string", "pattern": "^[0-9]+$" },
        "decimal": { "type": "string" }
      }
    },
    "tradability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "transfer_locked": { "type": "boolean" },
        "progress_percent": { "type": "number", "minimum": 0 },
        "max_supply": { "$ref": "#/$defs/amount" }
      }
    },
    "wallet_cap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["balance", "cap", "remaining", "reached"],
      "properties": {
        "balance": { "$ref": "#/$defs/amount" },
        "cap": { "$ref": "#/$defs/amount" },
        "remaining": { "$ref": "#/$defs/amount" },
        "reached": { "type": "boolean" }
      }
    }
  }
}
