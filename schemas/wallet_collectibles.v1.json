{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxion.dev/schemas/wallet_collectibles.v1.json",
  "title": "Fluxion wallet collectibles v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner", "block_number", "block_hash",
    "collections", "coverage", "sources", "warnings"
  ],
  "properties": {
    "owner": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "block_number": { "type": "integer", "minimum": 0 },
    "block_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["collection", "standard", "enumerable", "item_count", "items"],
        "properties": {
          "collection": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "name": { "type": "string" },
          "symbol": { "type": "string" },
          "standard": { "type": "string", "enum": ["erc721", "erc1155"] },
          "enumerable": { "type": "boolean" },
          "item_count": { "type": "integer", "minimum": 0 },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["token_id", "balance"],
              "properties": {
                "token_id": { "type": "string", "pattern": "^[0-9]+$" },
                "balance": { "type": "string", "pattern": "^[0-9]+$" }
              }
            }
          }
        }
      }
    },
    "coverage": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scope"],
        "properties": {
          "name": { "type": "string" },
          "scope": { "type": "string" },
          "block": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
