{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxion.dev/schemas/signature_inspect.v1.json",
  "title": "Fluxion signature.inspect v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chain", "chain_id", "kind", "findings", "calls", "risk", "coverage",
    "unknowns", "policy", "assurance", "explanation", "sources", "warnings"
  ],
  "properties": {
    "chain": { "type": "string", "enum": ["ethereum", "bsc"] },
    "chain_id": { "type": "integer", "minimum": 0 },
    "kind": { "type": "string", "enum": ["typed_data", "authorization_list", "user_operation"] },
    "from": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "chain_id": { "type": "string" },
        "verifying_contract": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "category", "severity", "title", "description",
          "evidence", "confidence", "deterministic"
        ],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "evidence": { "type": "object", "additionalProperties": { "type": "string" } },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "deterministic": { "type": "boolean" }
        }
      }
    },
    "calls": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["to", "value", "selector", "args"],
        "properties": {
          "to": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "value": { "type": "string", "pattern": "^[0-9]+$" },
          "selector": { "type": "string", "pattern": "^0x[0-9a-fA-F]*$" },
          "signature": { "type": "string" },
          "name": { "type": "string" },
          "args": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "type", "value"],
              "properties": {
                "name": { "type": "string" },
                "type": { "type": "string" },
                "value": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "risk": { "type": "string", "enum": ["critical", "high", "medium", "low", "unknown"] },
    "coverage": { "type": "string", "enum": ["complete", "partial", "unavailable", "not_configured"] },
    "unknowns": { "type": "array", "items": { "type": "string" } },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "decision", "blocked", "reasons"],
      "properties": {
        "mode": { "type": "string", "enum": ["not_configured", "advisory", "enforce"] },
        "decision": { "type": "string", "enum": ["not_configured", "allow", "warn", "block"] },
        "blocked": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleset_version", "report_id", "deterministic", "limitations"],
      "properties": {
        "ruleset_version": { "type": "string" },
        "report_id": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
        "deterministic": { "type": "boolean" },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "key_changes", "unknowns"],
      "properties": {
        "summary": { "type": "string" },
        "key_changes": { "type": "array", "items": { "type": "string" } },
        "unknowns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scope"],
        "properties": {
          "name": { "type": "string" },
          "scope": { "type": "string" }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
