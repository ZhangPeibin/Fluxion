{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxion.dev/schemas/wallet_agent_id.v1.json",
  "title": "Fluxion wallet Agent ID v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chain", "chain_id", "query", "found", "coverage", "sources", "warnings"
  ],
  "properties": {
    "chain": { "type": "string", "enum": ["bsc"] },
    "chain_id": { "type": "integer", "const": 56 },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "type": "string", "enum": ["handle", "address"] },
        "value": { "type": "string" }
      }
    },
    "found": { "type": "boolean" },
    "handle": { "type": "string" },
    "agent_id": { "type": "string" },
    "owner": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "token_id": { "type": "string", "pattern": "^[0-9]+$" },
    "tx_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "block_number": { "type": "integer", "minimum": 0 },
    "as_of_block": { "type": "integer", "minimum": 0 },
    "coverage": {
      "type": "string",
      "enum": ["api+onchain", "api", "onchain"]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scope"],
        "properties": {
          "name": { "type": "string" },
          "scope": { "type": "string" },
          "block": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
