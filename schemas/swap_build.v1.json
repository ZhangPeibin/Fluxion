{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxion.dev/schemas/swap_build.v1.json",
  "title": "Fluxion swap.build v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chain", "chain_id", "router", "value", "data", "token_in", "token_out",
    "amount_in", "amount_out_min", "recipient", "deadline", "path", "hops"
  ],
  "properties": {
    "chain": { "type": "string", "enum": ["ethereum"] },
    "chain_id": { "type": "integer", "minimum": 0 },
    "quote_block": { "type": ["integer", "null"], "minimum": 0 },
    "router": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "value": { "type": "string", "pattern": "^[0-9]+$" },
    "data": { "type": "string", "pattern": "^0x[0-9a-fA-F]*$" },
    "token_in": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "token_out": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "amount_in": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "decimal"],
      "properties": {
        "raw": { "type": "string", "pattern": "^[0-9]+$" },
        "decimal": { "type": "string" }
      }
    },
    "amount_out_min": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "decimal"],
      "properties": {
        "raw": { "type": "string", "pattern": "^[0-9]+$" },
        "decimal": { "type": "string" }
      }
    },
    "recipient": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "deadline": { "type": "integer", "minimum": 0 },
    "path": { "type": "array", "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" } },
    "hops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "token_in", "token_out", "amount_in", "amount_out"],
        "properties": {
          "platform": { "type": "string" },
          "token_in": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "token_out": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "amount_in": {
            "type": "object",
            "additionalProperties": false,
            "required": ["raw", "decimal"],
            "properties": {
              "raw": { "type": "string", "pattern": "^[0-9]+$" },
              "decimal": { "type": "string" }
            }
          },
          "amount_out": {
            "type": "object",
            "additionalProperties": false,
            "required": ["raw", "decimal"],
            "properties": {
              "raw": { "type": "string", "pattern": "^[0-9]+$" },
              "decimal": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
