{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxion.dev/schemas/transaction_simulate.v1.json",
  "title": "Fluxion transaction.simulate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "block_number", "block_hash", "to", "value",
    "success", "return_data"
  ],
  "properties": {
    "block_number": { "type": "integer", "minimum": 0 },
    "block_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "from": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "to": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "decimal"],
      "properties": {
        "raw": { "type": "string", "pattern": "^[0-9]+$" },
        "decimal": { "type": "string" }
      }
    },
    "success": { "type": "boolean" },
    "return_data": { "type": "string", "pattern": "^0x[0-9a-fA-F]*$" },
    "gas_estimate": { "type": "string", "pattern": "^[0-9]+$" },
    "revert_data": { "type": "string", "pattern": "^0x[0-9a-fA-F]*$" },
    "error": { "type": "string" }
  }
}
