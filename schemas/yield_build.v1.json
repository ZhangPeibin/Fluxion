{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eollo.xyz/schemas/yield_build.v1.json",
  "title": "Eollo yield.build v1",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "amount": {
      "type": "object",
      "required": ["raw", "decimal"],
      "additionalProperties": false,
      "properties": {
        "raw": { "type": "string", "pattern": "^[0-9]+$" },
        "decimal": { "type": "string" }
      }
    },
    "asset": {
      "type": "object",
      "required": ["symbol", "address", "decimals"],
      "additionalProperties": false,
      "properties": {
        "symbol": { "type": "string" },
        "address": { "type": "string" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 38 }
      }
    },
    "step": {
      "type": "object",
      "required": ["kind", "to", "data", "value", "description"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["wrap", "approve", "stake", "supply", "deposit"] },
        "to": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "data": { "type": "string", "pattern": "^0x[0-9a-fA-F]*$" },
        "value": { "type": "string", "pattern": "^[0-9]+$" },
        "token": { "type": "string" },
        "amount": { "$ref": "#/$defs/amount" },
        "description": { "type": "string" }
      }
    },
    "approval": {
      "type": "object",
      "required": ["token", "spender", "amount"],
      "additionalProperties": false,
      "properties": {
        "token": { "$ref": "#/$defs/asset" },
        "spender": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "amount": { "$ref": "#/$defs/amount" }
      }
    },
    "success": {
      "type": "object",
      "required": [
        "schema_version", "capability", "request_id", "chain", "opportunity_id",
        "action", "amount", "recipient", "deposit_asset", "receipt_asset",
        "requires_wrap", "steps", "approvals", "warnings", "disclaimer"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "capability": { "const": "yield.build" },
        "request_id": { "type": "string" },
        "chain": { "const": "ethereum" },
        "opportunity_id": { "type": "string" },
        "action": { "type": "string", "enum": ["stake", "lend"] },
        "amount": { "$ref": "#/$defs/amount" },
        "recipient": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "deposit_asset": { "$ref": "#/$defs/asset" },
        "receipt_asset": { "$ref": "#/$defs/asset" },
        "requires_wrap": { "type": "boolean" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "approvals": { "type": "array", "items": { "$ref": "#/$defs/approval" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "disclaimer": { "type": "string" }
      }
    },
    "error": {
      "type": "object",
      "required": ["schema_version", "capability", "request_id", "error"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "const": 1 },
        "capability": { "const": "yield.build" },
        "request_id": { "type": "string" },
        "error": {
          "type": "object",
          "required": ["code", "message", "retryable"],
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
