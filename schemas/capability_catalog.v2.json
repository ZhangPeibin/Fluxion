{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eollo.xyz/schemas/capability_catalog.v2.json",
  "title": "Eollo capability catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated", "envelope", "capabilities"],
  "properties": {
    "version": {
      "const": 2
    },
    "updated": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "envelope": {
      "enum": ["v1", "v2"]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workflow"
      }
    }
  },
  "$defs": {
    "domain": {
      "enum": ["swap", "wallet", "transaction", "signature", "yield", "position", "fourmeme"]
    },
    "action": {
      "enum": [
        "quote",
        "build",
        "simulate",
        "inspect",
        "send",
        "sign",
        "read",
        "discover",
        "analyze",
        "connect",
        "disconnect",
        "status",
        "agent-id",
        "withdraw"
      ]
    },
    "chain": {
      "enum": ["ethereum", "bsc"]
    },
    "status": {
      "enum": ["proposed", "experimental", "stable", "deprecated"]
    },
    "execution": {
      "enum": ["local", "remote"]
    },
    "transport": {
      "enum": ["mcp", "cli", "http"]
    },
    "side_effect": {
      "enum": ["read_only", "local_session", "prepares_calldata", "signs", "broadcasts"]
    },
    "coverage_dimension": {
      "enum": [
        "data",
        "decode",
        "metadata",
        "simulation",
        "trace",
        "policy",
        "freshness",
        "eligibility"
      ]
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "enum": ["rpc", "provider", "wallet", "registry", "capability"]
        },
        "details": {
          "type": "object"
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "action",
        "status",
        "summary",
        "execution",
        "transports",
        "chains",
        "side_effects",
        "schema",
        "skill",
        "docs",
        "coverage_dimensions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
        },
        "domain": {
          "$ref": "#/$defs/domain"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "envelope": {
          "enum": ["v1", "v2"]
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "transports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/transport"
          }
        },
        "chains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/chain"
          }
        },
        "default_chain": {
          "$ref": "#/$defs/chain"
        },
        "chain_required": {
          "type": "boolean"
        },
        "side_effects": {
          "$ref": "#/$defs/side_effect"
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "docs": {
          "type": "string",
          "minLength": 1
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "workflows": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "coverage_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/coverage_dimension"
          }
        },
        "replacement": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "chain_required": {
                "const": true
              }
            },
            "required": ["chain_required"]
          },
          "then": {
            "not": {
              "required": ["default_chain"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "deprecated"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["replacement"]
          }
        }
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "capability", "status", "summary", "transports", "chains", "docs"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
        },
        "kind": {
          "enum": ["local_web_ui", "cli_only", "documentation"]
        },
        "capability": {
          "const": false
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "transports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/transport"
          }
        },
        "chains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/chain"
          }
        },
        "docs": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "status", "chains", "steps"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "chains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/chain"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
          }
        },
        "planned_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$"
          }
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "docs": {
          "type": "string",
          "minLength": 1
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "stable"
              }
            },
            "required": ["status"]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": ["planned_steps"]
                },
                {
                  "required": ["gaps"]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
