{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxion.dev/schemas/fourmeme_agent_tokens.v1.json",
  "title": "Fluxion fourmeme.agent-tokens v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chain",
    "mode",
    "scanned",
    "lookback_blocks",
    "from_block",
    "to_block",
    "tokens",
    "coverage",
    "sources",
    "warnings"
  ],
  "properties": {
    "chain": {
      "type": "string",
      "enum": [
        "bsc"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "binance_agent_id_exclusive"
      ]
    },
    "scanned": {
      "type": "integer",
      "minimum": 0
    },
    "lookback_blocks": {
      "type": "integer",
      "minimum": 1
    },
    "from_block": {
      "type": "integer",
      "minimum": 0
    },
    "to_block": {
      "type": "integer",
      "minimum": 0
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "name",
          "symbol",
          "template_id",
          "phase",
          "agent_id_exclusive"
        ],
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "name": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "template_id": {
            "type": "string"
          },
          "phase": {
            "type": "string",
            "enum": [
              "bonding",
              "graduated",
              "unknown"
            ]
          },
          "progress": {
            "type": "string"
          },
          "raised": {
            "type": "string"
          },
          "agent_id_exclusive": {
            "type": "boolean"
          },
          "wallet_eligible": {
            "type": "boolean"
          },
          "eligibility_reason": {
            "type": "string"
          },
          "image": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "scope"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "block": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
