{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxion.dev/schemas/wallet_status.v1.json",
  "title": "Fluxion wallet status v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "accounts"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["disconnected", "pending", "connected", "expired", "error"]
    },
    "accounts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
    },
    "chain_id": { "type": "integer", "minimum": 0 },
    "expires_at": { "type": "integer" },
    "connection_id": { "type": "string" },
    "wallet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "icons": { "type": "array", "items": { "type": "string" } }
      }
    },
    "error": { "type": "string" }
  }
}
