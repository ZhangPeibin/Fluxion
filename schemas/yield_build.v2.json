{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eollo.xyz/schemas/yield_build.v2.json",
  "title": "Eollo yield.build v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta", "chain", "as_of", "provenance", "coverage",
    "warnings", "unknowns", "data"
  ],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "chain": { "$ref": "#/$defs/chain" },
    "as_of": { "type": "string" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "unknowns": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id", "action", "amount", "recipient", "deposit_asset",
        "receipt_asset", "requires_wrap", "steps", "approvals", "disclaimer"
      ],
      "properties": {
        "opportunity_id": { "type": "string" },
        "action": { "type": "string", "enum": ["stake", "lend"] },
        "amount": { "$ref": "yield_build.v1.json#/$defs/amount" },
        "recipient": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "deposit_asset": { "$ref": "yield_build.v1.json#/$defs/asset" },
        "receipt_asset": { "$ref": "yield_build.v1.json#/$defs/asset" },
        "requires_wrap": { "type": "boolean" },
        "steps": {
          "type": "array",
          "items": { "$ref": "yield_build.v1.json#/$defs/step" }
        },
        "approvals": {
          "type": "array",
          "items": { "$ref": "yield_build.v1.json#/$defs/approval" }
        },
        "disclaimer": { "type": "string" }
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "capability", "request_id"],
      "properties": {
        "schema_version": { "const": 2 },
        "capability": { "const": "yield.build" },
        "request_id": { "type": "string", "minLength": 1 }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id"],
      "properties": {
        "name": { "const": "ethereum" },
        "id": { "const": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "freshness"],
      "properties": {
        "sources": { "type": "array", "items": { "type": "object" } },
        "freshness": { "type": "string", "enum": ["fresh", "stale", "expired", "unknown"] },
        "age_secs": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions"],
      "properties": {
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["complete", "partial", "not_run", "unavailable", "not_configured"]
          }
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "source": { "type": "string" },
        "details": { "type": "object" }
      }
    }
  }
}
