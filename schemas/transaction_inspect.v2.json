{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxion.dev/schemas/transaction_inspect.v2.json",
  "title": "Fluxion transaction.inspect v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta", "chain", "block", "as_of", "provenance", "coverage",
    "warnings", "unknowns", "data"
  ],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "chain": { "$ref": "#/$defs/chain" },
    "block": { "$ref": "#/$defs/block" },
    "as_of": { "type": "string" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "unknowns": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to", "value", "intent", "target", "effects", "findings",
        "risk", "policy", "assurance", "explanation"
      ],
      "properties": {
        "from": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "to": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "value": { "$ref": "transaction_inspect.v1.json#/properties/value" },
        "intent": { "$ref": "transaction_inspect.v1.json#/properties/intent" },
        "target": { "$ref": "transaction_inspect.v1.json#/properties/target" },
        "effects": { "$ref": "transaction_inspect.v1.json#/properties/effects" },
        "findings": { "$ref": "transaction_inspect.v1.json#/properties/findings" },
        "risk": { "$ref": "transaction_inspect.v1.json#/properties/risk" },
        "policy": { "$ref": "transaction_inspect.v1.json#/properties/policy" },
        "assurance": { "$ref": "transaction_inspect.v1.json#/properties/assurance" },
        "explanation": { "$ref": "transaction_inspect.v1.json#/properties/explanation" }
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "capability", "request_id"],
      "properties": {
        "schema_version": { "const": 2 },
        "capability": { "const": "transaction.inspect" },
        "request_id": { "type": "string", "minLength": 1 }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id"],
      "properties": {
        "name": { "type": "string", "enum": ["ethereum", "bsc"] },
        "id": { "type": "integer", "enum": [1, 56] }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number"],
      "properties": {
        "number": { "type": "integer", "minimum": 0 },
        "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "freshness"],
      "properties": {
        "sources": { "type": "array", "items": { "type": "object" } },
        "freshness": { "type": "string", "enum": ["fresh", "stale", "expired", "unknown"] },
        "age_secs": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions"],
      "properties": {
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["complete", "partial", "not_run", "unavailable", "not_configured"]
          }
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "source": { "type": "string" },
        "details": { "type": "object" }
      }
    }
  }
}
