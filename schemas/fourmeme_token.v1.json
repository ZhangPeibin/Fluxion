{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhangpeibin.github.io/eollo/schemas/fourmeme_token.v1.json",
  "title": "Eollo fourmeme.token v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["chain", "address", "name", "symbol", "phase", "coverage", "sources", "warnings"],
  "properties": {
    "chain": { "type": "string", "enum": ["bsc"] },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "name": { "type": "string" },
    "symbol": { "type": "string" },
    "image": { "type": "string" },
    "description": { "type": "string" },
    "phase": { "type": "string", "enum": ["bonding", "graduated", "unknown"] },
    "template_id": { "type": "string" },
    "template_name": { "type": "string" },
    "agent_id_exclusive": { "type": "boolean" },
    "progress": { "type": "string" },
    "raised": { "type": "string" },
    "market_cap": { "type": "string" },
    "price": { "type": "string" },
    "total_supply": { "type": "string" },
    "sale_amount": { "type": "string" },
    "creator": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "created_at": { "type": "integer", "minimum": 0 },
    "launch_at": { "type": "integer", "minimum": 0 },
    "ai_creator": { "type": "boolean" },
    "version": { "type": "string" },
    "wallet_eligible": { "type": "boolean" },
    "eligibility_reason": { "type": "string" },
    "coverage": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scope"],
        "properties": {
          "name": { "type": "string" },
          "scope": { "type": "string" },
          "block": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
