{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluxion.dev/schemas/wallet_allowances.v1.json",
  "title": "Fluxion wallet allowances v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner", "spender", "block_number", "block_hash",
    "allowances", "coverage", "sources", "warnings"
  ],
  "properties": {
    "owner": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "spender": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "block_number": { "type": "integer", "minimum": 0 },
    "block_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
    "allowances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token", "spender", "amount", "known"],
        "properties": {
          "token": {
            "type": "object",
            "additionalProperties": false,
            "required": ["address", "decimals"],
            "properties": {
              "symbol": { "type": "string" },
              "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
              "decimals": { "type": "integer", "minimum": 0, "maximum": 38 }
            }
          },
          "spender": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
          "amount": {
            "type": "object",
            "additionalProperties": false,
            "required": ["raw", "decimal"],
            "properties": {
              "raw": { "type": "string", "pattern": "^[0-9]+$" },
              "decimal": { "type": "string" }
            }
          },
          "known": { "type": "boolean" }
        }
      }
    },
    "coverage": { "type": "string" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scope"],
        "properties": {
          "name": { "type": "string" },
          "scope": { "type": "string" },
          "block": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
