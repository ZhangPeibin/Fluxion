{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhangpeibin.github.io/eollo/schemas/transaction_verify.v2.json",
  "title": "Eollo transaction.verify v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta", "chain", "block", "as_of", "provenance", "coverage",
    "warnings", "unknowns", "data"
  ],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "chain": { "$ref": "#/$defs/chain" },
    "block": { "$ref": "#/$defs/block" },
    "as_of": { "type": "string" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "unknowns": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tx_hash", "status", "confirmations", "expectation"],
      "properties": {
        "tx_hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" },
        "status": { "type": "string", "enum": ["success", "reverted", "pending", "not_found"] },
        "from": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "to": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "value": { "$ref": "#/$defs/amount" },
        "confirmations": { "type": "integer", "minimum": 0 },
        "gas_used": { "type": "string", "pattern": "^[0-9]+$" },
        "effective_gas_price": { "type": "string", "pattern": "^[0-9]+$" },
        "fee": { "$ref": "#/$defs/amount" },
        "logs_count": { "type": "integer", "minimum": 0 },
        "effects": { "$ref": "#/$defs/effects" },
        "expectation": { "$ref": "#/$defs/expectation" }
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "capability", "request_id"],
      "properties": {
        "schema_version": { "const": 2 },
        "capability": { "const": "transaction.verify" },
        "request_id": { "type": "string", "minLength": 1 }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id"],
      "properties": {
        "name": { "type": "string", "enum": ["ethereum", "bsc"] },
        "id": { "type": "integer", "enum": [1, 56] }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number"],
      "properties": {
        "number": { "type": "integer", "minimum": 0 },
        "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "freshness"],
      "properties": {
        "sources": { "type": "array", "items": { "type": "object" } },
        "freshness": { "type": "string", "enum": ["fresh", "stale", "expired", "unknown"] },
        "age_secs": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions"],
      "properties": {
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["complete", "partial", "not_run", "unavailable", "not_configured"]
          }
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "source": { "type": "string" },
        "details": { "type": "object" }
      }
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "decimal"],
      "properties": {
        "raw": { "type": "string", "pattern": "^-?[0-9]+$" },
        "decimal": { "type": "string" }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "native": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["account", "delta"],
            "properties": {
              "account": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
              "delta": { "type": "string", "pattern": "^-?[0-9]+$" }
            }
          }
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["token", "account", "delta"],
            "properties": {
              "token": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
              "account": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
              "delta": { "type": "string", "pattern": "^-?[0-9]+$" }
            }
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["token", "owner", "spender", "after"],
            "properties": {
              "token": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
              "owner": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
              "spender": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
              "before": { "type": "string", "pattern": "^[0-9]+$" },
              "after": { "type": "string", "pattern": "^[0-9]+$" }
            }
          }
        },
        "nfts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["collection", "token_id", "from", "to"],
            "properties": {
              "collection": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
              "token_id": { "type": "string", "pattern": "^[0-9]+$" },
              "from": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
              "to": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }
            }
          }
        }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mismatches"],
      "properties": {
        "status": { "type": "string", "enum": ["match", "mismatch", "not_configured"] },
        "mismatches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "expected", "actual"],
            "properties": {
              "kind": { "type": "string", "enum": ["native", "token", "approval", "nft"] },
              "expected": { "type": "string" },
              "actual": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
