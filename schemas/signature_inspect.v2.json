{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eollo.xyz/schemas/signature_inspect.v2.json",
  "title": "Eollo signature.inspect v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta", "chain", "as_of", "provenance", "coverage",
    "warnings", "unknowns", "data"
  ],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "chain": { "$ref": "#/$defs/chain" },
    "as_of": { "type": "string" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "coverage": { "$ref": "#/$defs/coverage" },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "unknowns": { "type": "array", "items": { "$ref": "#/$defs/notice" } },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "findings", "calls", "risk", "policy", "assurance", "explanation"],
      "properties": {
        "kind": { "type": "string", "enum": ["typed_data", "authorization_list", "user_operation"] },
        "from": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
        "domain": { "$ref": "signature_inspect.v1.json#/properties/domain" },
        "findings": { "$ref": "signature_inspect.v1.json#/properties/findings" },
        "calls": { "$ref": "signature_inspect.v1.json#/properties/calls" },
        "risk": { "$ref": "signature_inspect.v1.json#/properties/risk" },
        "policy": { "$ref": "signature_inspect.v1.json#/properties/policy" },
        "assurance": { "$ref": "signature_inspect.v1.json#/properties/assurance" },
        "explanation": { "$ref": "signature_inspect.v1.json#/properties/explanation" }
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "capability", "request_id"],
      "properties": {
        "schema_version": { "const": 2 },
        "capability": { "const": "signature.inspect" },
        "request_id": { "type": "string", "minLength": 1 }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id"],
      "properties": {
        "name": { "type": "string", "enum": ["ethereum", "bsc"] },
        "id": { "type": "integer", "enum": [1, 56] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "freshness"],
      "properties": {
        "sources": { "type": "array", "items": { "type": "object" } },
        "freshness": { "type": "string", "enum": ["fresh", "stale", "expired", "unknown"] },
        "age_secs": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimensions"],
      "properties": {
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": ["complete", "partial", "not_run", "unavailable", "not_configured"]
          }
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "source": { "type": "string" },
        "details": { "type": "object" }
      }
    }
  }
}
